rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['name', 'avatar', 'score', 'butterfliesCount']) &&
             data.keys().hasOnly(['name', 'avatar', 'score', 'butterfliesCount', 'createdAt']) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 30 &&
             data.avatar is string && data.avatar.size() <= 20 &&
             data.score is int && data.score >= 0 && data.score <= 10000 &&
             data.butterfliesCount is int && data.butterfliesCount >= 0 && data.butterfliesCount <= 100 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    match /leaderboard/{entryId} {
      allow read: if true;
      allow create: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow update: if isValidId(entryId) && isValidLeaderboardEntry(request.resource.data);
      allow delete: if false;
    }
  }
}
